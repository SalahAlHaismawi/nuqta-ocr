<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/rule"/><corners android:radius="14dp"/></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape><solid android:color="@color/white"/><corners android:radius="13dp"/></shape></item>
    <item android:gravity="end|fill_vertical" android:width="4dp" android:top="14dp" android:bottom="14dp">
        <shape><solid android:color="@color/green"/><corners android:radius="2dp"/></shape></item>
</layer-list>
